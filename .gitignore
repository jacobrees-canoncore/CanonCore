# Local, per-machine Claude Code settings. Project skills (.claude/skills/) are tracked,
# and a project .claude/settings.json would be too if one is ever added; this one is not.
.claude/settings.local.json

# Scratch output from browser/automation MCP servers
.playwright-mcp/

# `vercel link` writes the project link here. Per-machine, and it holds no secret,
# but it pins a project id that a fork has no business inheriting.
.vercel/

# Secrets — never commit. A `.env.example`, if one is ever added, is deliberately
# NOT ignored: it documents the required variables and belongs in the repo.
.env
.env.local
.env.*.local

# Dependencies and build output
node_modules/
.next/
*.tsbuildinfo

# Generated, not authored. `next typegen` rewrites it, observed here by
# deleting it and running `pnpm -r typecheck` on a clean checkout; the file
# itself says "This file should not be edited". create-next-app ignores it too.
next-env.d.ts

# Written by `next dev` on every run, and re-added if deleted — the block inside says so, and
# names `next/dist/server/lib/generate-agent-files.js` as what writes it. Next's own advice is to
# commit them; not done here, because `apps/web/CLAUDE.md` would be a second always-loaded
# instruction file for everything under that directory, and what an agent reads in this repository
# is a decision rather than a build artefact. Named in full rather than as bare `AGENTS.md` /
# `CLAUDE.md`, so the repository-root instructions can never be caught by this.
apps/web/AGENTS.md
apps/web/CLAUDE.md

# Playwright's own artefacts, written wherever the suite is run from
test-results/
playwright-report/

# macOS
.DS_Store
