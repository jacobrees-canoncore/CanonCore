{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    // Node 24 strips types at run time, so `node scripts/check-docs.ts` needs no build step —
    // but its import specifiers must name the real `.ts` files rather than a compiled `.js`.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["**/*.ts"]
}
